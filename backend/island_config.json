{
  "style": "dynamic_island",
  "collapsed": {
    "width": 200,
    "height": 44
  },
  "hover": {
    "width": 240,
    "height": 52
  },
  "expanded": {
    "width": 360,
    "height": 120
  },
  "background_color": "#000000",
  "background_alpha": 0.92,
  "anchor": "top_center",
  "animation": {
    "expand_ms": 320,
    "collapse_ms": 240,
    "hover_ms": 200
  },
  "auto_hide": true,
  "auto_hide_delay": 10000,
  "stay_on_top": true
}
